# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face token
HF_TOKEN=your_huggingface_token_here


# Gemini models
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro


# Image generation
IMAGE_BACKEND=hf

HF_IMAGE_MODEL=stabilityai/stable-diffusion-3.5-large

HF_PROVIDER=auto


# Local image generation
LOCAL_IMAGE_MODEL=runwayml/stable-diffusion-v1-5


# Application
APP_NAME=ComicCraft

APP_ENV=development

HOST=127.0.0.1

PORT=8000


# Limits
MAX_PROMPT_LENGTH=1200

MAX_CHARACTER_LENGTH=60

MAX_SETTING_LENGTH=100